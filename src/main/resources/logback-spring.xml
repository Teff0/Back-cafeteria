<?xml version="1.0" encoding="UTF-8"?>
<!--
  Configuracion de logs de la Cafeteria (PDF S16 - Monitoreo).
  - Escribe a consola y a archivo (logs/cafeteria.log).
  - Rotacion diaria y por tamano (10 MB); conserva 15 dias, tope 200 MB.
  Los niveles por paquete se siguen controlando desde application.properties.
-->
<configuration>

    <property name="LOG_DIR" value="logs"/>
    <property name="PATTERN"
              value="%d{yyyy-MM-dd HH:mm:ss} %-5level [%thread] %logger{36} - %msg%n"/>

    <!-- Salida por consola -->
    <appender name="CONSOLE" class="ch.qos.logback.core.ConsoleAppender">
        <encoder>
            <pattern>${PATTERN}</pattern>
            <charset>UTF-8</charset>
        </encoder>
    </appender>

    <!-- Salida a archivo con rotacion -->
    <appender name="FILE" class="ch.qos.logback.core.rolling.RollingFileAppender">
        <file>${LOG_DIR}/cafeteria.log</file>
        <rollingPolicy class="ch.qos.logback.core.rolling.SizeAndTimeBasedRollingPolicy">
            <!-- Un archivo por dia; si supera el tamano, se numera (.0, .1, ...) -->
            <fileNamePattern>${LOG_DIR}/cafeteria-%d{yyyy-MM-dd}.%i.log</fileNamePattern>
            <maxFileSize>10MB</maxFileSize>
            <maxHistory>15</maxHistory>
            <totalSizeCap>200MB</totalSizeCap>
        </rollingPolicy>
        <encoder>
            <pattern>${PATTERN}</pattern>
            <charset>UTF-8</charset>
        </encoder>
    </appender>

    <root level="INFO">
        <appender-ref ref="CONSOLE"/>
        <appender-ref ref="FILE"/>
    </root>

</configuration>
