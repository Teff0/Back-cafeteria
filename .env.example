# Copia este archivo a .env y completa los valores reales.
# NUNCA commitees el archivo .env (esta en .gitignore).

# Base de datos MySQL
DB_HOST=localhost
DB_PORT=3306
DB_NAME=cafeteria
DB_USER=root
DB_PASSWORD=tu_password_aqui

# JWT (generar con: openssl rand -base64 64)
JWT_SECRET=cambia_esto_por_un_secreto_seguro_de_al_menos_64_caracteres
JWT_EXPIRATION=86400000

# Servidor
SERVER_PORT=8080

# CORS - origenes permitidos (sin espacios)
CORS_ALLOWED_ORIGINS=http://localhost:4200
