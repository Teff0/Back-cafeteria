# Copia este archivo a .env y completa los valores reales.
# NUNCA commitees el archivo .env (esta en .gitignore).

# Supabase
SUPABASE_URL=https://<tu-proyecto>.supabase.co
SUPABASE_KEY=<anon-key>
SUPABASE_SERVICE_KEY=<service-role-key>

# Base de datos (Supabase Postgres)
DB_URL=<host-postgres-sin-https>
DB_PORT=5432
DB_NAME=postgres
DB_USER=postgres
DB_PASSWORD=<password>

# JWT (generar con: openssl rand -base64 64)
JWT_SECRET=<secret-base64-min-64-bytes>
JWT_EXPIRATION=86400000

# Servidor
SERVER_PORT=8080

# CORS - lista separada por comas con los origenes permitidos (sin espacios).
# Ejemplo dev: http://localhost:5173,http://localhost:3000
CORS_ALLOWED_ORIGINS=http://localhost:5173
