# Copia este archivo a .env y completa los valores reales.
# NUNCA commitees el archivo .env (esta en .gitignore).

# Base de datos MySQL
DB_HOST=localhost
DB_PORT=3306
DB_NAME=cafeteria
DB_USER=root
DB_PASSWORD=tu_password_mysql

# JWT (el secret debe estar en Base64; generar con: openssl rand -base64 64)
